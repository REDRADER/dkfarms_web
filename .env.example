# Copy to .env.local for development. On the host (e.g. Vercel), set these in
# the project's Environment Variables settings instead. Never commit real values.

# --- Look ---------------------------------------------------------------------
# Colour system the site is deployed with: sage | blush | mist
NEXT_PUBLIC_THEME=sage
# Shows the floating "Palette" switcher for testing. Leave false in production.
NEXT_PUBLIC_THEME_SWITCHER=false

# --- Analytics ----------------------------------------------------------------
# Google Analytics 4 measurement ID (optional), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# --- Enquiry email (server-only: never prefix these with NEXT_PUBLIC_) --------
# Gmail account that sends the enquiry emails. Gmail needs an *App Password*,
# not the normal password: Google Account → Security → 2-Step Verification on →
# App passwords → create one for "Mail". Paste the 16 characters below.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where enquiries are delivered. Defaults to GMAIL_USER if empty.
ENQUIRY_TO=
